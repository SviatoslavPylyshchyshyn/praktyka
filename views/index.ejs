<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.cdnfonts.com/css/times-new-roman" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css?v=20260917-4">
    <link rel="icon" href="/favicon-konverter.png" type="image/png">
    <title>KONVERTER YT</title>
</head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-9VYKQ8W52L"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-9VYKQ8W52L');
</script>
<body>
    <div class="background-overlay" aria-hidden="true"></div>
    <div class="top-container">
        <div class="top-bar">
            <nav class="view-switcher" aria-label="Application views">
                <a class="view-tab active" href="/" data-i18n="mainWindow">Home</a>
                <a class="view-tab" href="/history" data-i18n="downloadHistory">Download History</a>
                <a class="view-tab settings-tab" href="/settings" data-i18n="settings">Settings</a>
            </nav>
        </div>

        <section class="app-view active-view">
            <div class="main-layout">
                <form onsubmit="startProcess(event)">
                    <h1 data-i18n="appTitle">Konverter MP3/MP4</h1>
                    <div class="url-row">
                        <input type="text" id="urlInput" data-i18n-placeholder="urlPlaceholder" placeholder="Paste Link Here" required>
                        <button type="button" id="clearUrlBtn" class="clear-url" aria-label="Clear link" data-i18n-title="clearTooltip" title="Clear link">&times;</button>
                    </div>
                    <div class="format-row">
                        <div class="select-shell">
                            <select id="formatInput" aria-label="Download format">
                                <option value="mp3" selected>MP3</option>
                                <option value="mp4">MP4</option>
                            </select>
                        </div>
                        <div class="select-shell">
                            <select id="qualityInput" aria-label="Download quality">
                                <option value="64">64 kbps</option>
                                <option value="128">128 kbps</option>
                                <option value="196" selected>196 kbps</option>
                                <option value="256">256 kbps</option>
                                <option value="320">320 kbps</option>
                            </select>
                        </div>
                    </div>
                    <div class="convert-row">
                        <button type="submit" id="convertBtn" data-i18n="convertBtn">Convert</button>
                    </div>
                    <div class="download-row">
                        <button type="button" id="dlBtn" data-i18n="downloadBtn">Download</button>
                        <button type="button" id="filenameToggle" class="filename-toggle" aria-expanded="false" data-i18n-title="filenameTooltip" title="Set file name">
                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div id="filename-panel" class="filename-panel" hidden>
                        <input type="text" id="filenameInput" data-i18n-placeholder="filenamePlaceholder" placeholder="File name (optional)" aria-label="File name">
                    </div>
                    <div id="progress-area">
                        <div class="bar-bg"><div class="bar-fg" id="bar">0%</div></div>
                        <p id="status-txt" data-i18n="statusStarting">Starting...</p>
                    </div>
                </form>

                <aside class="instructions-panel" aria-label="Instructions for using the app">
                    <h2 data-i18n="instructionsTitle">How to use</h2>
                    <ol>
                        <li data-i18n="instruction1">Paste any YouTube link into the field.</li>
                        <li data-i18n="instruction2">Select MP3 or MP4 and choose the quality.</li>
                        <li>
                            <span data-i18n="instruction3a">Click</span>
                            <strong data-i18n="instruction3b">Convert</strong>
                            <span data-i18n="instruction3c">and wait for the progress bar to finish.</span>
                        </li>
                        <li>
                            <span data-i18n="instruction4a">When it says the file is ready, click</span>
                            <strong data-i18n="instruction4b">Download</strong><span data-i18n="instruction4c">.</span>
                        </li>
                        <li data-i18n="instruction5">Optional: set a custom file name before downloading.</li>
                    </ol>
                </aside>
            </div>
        </section>
    </div>

    <footer class="site-footer">
        <a href="/terms" class="footer-terms" data-i18n="termsUsage">Terms of usage</a>
        <a href="/contact" class="footer-terms" data-i18n="contact">Contact</a>
    </footer>

    <!-- HIDDEN FORM FOR DOWNLOADING (Magic happens here) -->
    <form id="hidden-dl-form" action="/api/stream" method="POST" style="display: none;">
        <input type="hidden" name="downloadUrl" id="hiddenUrl">
        <input type="hidden" name="title" id="hiddenTitle">
        <input type="hidden" name="format" id="hiddenFormat">
    </form>
    <script>
        let convertedFile = null;
        const historyStorageKey = 'youtube-converter-download-history';

        const translations = {
            en: {
                mainWindow: 'Home',
                downloadHistory: 'Download History',
                settings: 'Settings',
                termsUsage: 'Terms of usage',
                contact: 'Contact',
                languageLabel: 'Language',
                appTitle: 'Konverter MP3/MP4',
                urlPlaceholder: 'Paste Link Here',
                clearTooltip: 'Clear link',
                convertBtn: 'Convert',
                downloadBtn: 'Download',
                filenameTooltip: 'Set file name',
                filenamePlaceholder: 'File name (optional)',
                statusStarting: 'Starting...',
                instructionsTitle: 'How to use',
                instruction1: 'Paste any YouTube link into the field.',
                instruction2: 'Select MP3 or MP4 and choose the quality.',
                instruction3a: 'Click',
                instruction3b: 'Convert',
                instruction3c: 'and wait for the progress bar to finish.',
                instruction4a: 'When it says the file is ready, click',
                instruction4b: 'Download',
                instruction4c: '.',
                instruction5: 'Optional: set a custom file name before downloading.'
            },
            uk: {
                mainWindow: 'Головна',
                downloadHistory: 'Історія завантажень',
                settings: 'Налаштування',
                termsUsage: 'Умови використання',
                contact: 'Контакт',
                languageLabel: 'Мова',
                appTitle: 'Konverter MP3/MP4',
                urlPlaceholder: 'Вставте посилання тут',
                clearTooltip: 'Очистити посилання',
                convertBtn: 'Конвертувати',
                downloadBtn: 'Завантажити',
                filenameTooltip: 'Встановити назву файлу',
                filenamePlaceholder: 'Назва файлу (необов’язково)',
                statusStarting: 'Початок...',
                instructionsTitle: 'Як користуватися',
                instruction1: 'Вставте будь-яке посилання YouTube в поле.',
                instruction2: 'Виберіть MP3 або MP4 і якість.',
                instruction3a: 'Натисніть',
                instruction3b: 'Конвертувати',
                instruction3c: 'і дочекайтеся завершення процесу.',
                instruction4a: 'Коли файл буде готовий, натисніть',
                instruction4b: 'Завантажити',
                instruction4c: '.',
                instruction5: 'Необов’язково: задайте власну назву файлу перед завантаженням.'
            }
        };

        const settingsStorageKey = 'youtube-converter-settings';

        function ensureSavedSettings() {
            try {
                const saved = JSON.parse(localStorage.getItem(settingsStorageKey) || '{}');
                const safeSettings = saved && typeof saved === 'object' ? saved : {};
                localStorage.setItem(settingsStorageKey, JSON.stringify(safeSettings));
                return safeSettings;
            } catch {
                return {};
            }
        }

        ensureSavedSettings();

        function updateLanguageFlag() {
            const flag = document.getElementById('languageFlag');
            const select = document.getElementById('languageSelect');
            if (!flag || !select) return;
            flag.classList.toggle('english-flag', select.value === 'en');
            flag.classList.toggle('uk-flag', select.value === 'uk');
        }

        const languageStorageKey = 'youtube-converter-language';

        function getSavedLanguage() {
            try {
                const savedLanguage = localStorage.getItem(languageStorageKey);
                return savedLanguage === 'uk' || savedLanguage === 'en' ? savedLanguage : 'en';
            } catch {
                return 'en';
            }
        }

        function setLanguage(lang) {
            const dictionary = translations[lang] || translations.en;
            document.querySelectorAll('[data-i18n]').forEach((element) => {
                const key = element.getAttribute('data-i18n');
                if (dictionary[key]) {
                    element.textContent = dictionary[key];
                }
            });

            document.querySelectorAll('[data-i18n-placeholder]').forEach((element) => {
                const key = element.getAttribute('data-i18n-placeholder');
                if (dictionary[key]) {
                    element.setAttribute('placeholder', dictionary[key]);
                }
            });

            document.querySelectorAll('[data-i18n-title]').forEach((element) => {
                const key = element.getAttribute('data-i18n-title');
                if (dictionary[key]) {
                    element.setAttribute('title', dictionary[key]);
                    element.setAttribute('aria-label', dictionary[key]);
                }
            });

            const statusText = document.getElementById('status-txt');
            if (statusText && statusText.dataset.defaultText) {
                statusText.textContent = statusText.dataset.defaultText;
            }
        }

        const languageSelect = document.getElementById('languageSelect');
        const savedLanguage = getSavedLanguage();
        if (languageSelect) {
            languageSelect.value = savedLanguage;
            languageSelect.addEventListener('change', (event) => {
                const selectedLanguage = event.target.value;
                try {
                    localStorage.setItem(languageStorageKey, selectedLanguage);
                } catch {}
                updateLanguageFlag();
                setLanguage(selectedLanguage);
            });
        }
        updateLanguageFlag();
        setLanguage(savedLanguage);

        function getDownloadHistory() {
            try {
                return JSON.parse(localStorage.getItem(historyStorageKey)) || [];
            } catch {
                return [];
            }
        }

        function saveDownloadToHistory(file) {
            const history = getDownloadHistory();
            history.unshift({
                id: Date.now().toString(),
                title: document.getElementById('filenameInput').value.trim() || file.title,
                format: file.format,
                quality: document.getElementById('qualityInput').value + (file.format === 'mp3' ? ' kbps' : 'p'),
                downloadedAt: new Date().toLocaleString()
            });
            localStorage.setItem(historyStorageKey, JSON.stringify(history.slice(0, 50)));
        }

        async function startProcess(e) {
            e.preventDefault();
            
            const url = document.getElementById('urlInput').value;
            const format = document.getElementById('formatInput').value;
            const quality = document.getElementById('qualityInput').value;
            const convertBtn = document.getElementById('convertBtn');
            const area = document.getElementById('progress-area');
            const bar = document.getElementById('bar');
            const txt = document.getElementById('status-txt');

            convertedFile = null;
            convertBtn.disabled = true;
            convertBtn.innerText = 'Converting...';
            area.style.display = 'block';
            bar.style.width = '0%';
            bar.innerText = '0%';
            bar.style.background = '#4CAF50';

            try {
                const startRes = await fetch('/api/start', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ url, format, quality })
                });
                const startData = await startRes.json();
                
                if(!startData.success) throw new Error(startData.error);

                const interval = setInterval(async () => {
                    try {
                        const pollRes = await fetch(`/api/status?id=${startData.pid}`);
                        const pollData = await pollRes.json();
                        const progress = pollData.progress || 0;
                        const percent = Math.floor(progress / 10);

                        bar.style.width = percent + '%';
                        bar.innerText = percent + '%';
                        txt.innerText = 'Converting...';

                        if (pollData.downloadUrl) {
                            clearInterval(interval);
                            convertedFile = {
                                url: pollData.downloadUrl,
                                title: startData.title,
                                format
                            };
                            txt.innerText = 'File converted. Click Download.';
                            bar.style.width = '100%';
                            bar.innerText = '100%';
                            bar.style.background = '#2196F3';
                            convertBtn.disabled = false;
                            convertBtn.innerText = 'Convert Again';
                        }
                    } catch (pollError) {
                        clearInterval(interval);
                        throw pollError;
                    }
                }, 6000); // Check every 6 second

            } catch (err) {
                console.error(err);
                txt.innerText = "Error: " + err.message;
                convertBtn.disabled = false;
                convertBtn.innerText = 'Convert';
            }
        }

        document.getElementById('dlBtn').addEventListener('click', () => {
            if (!convertedFile) {
                const downloadBtn = document.getElementById('dlBtn');
                downloadBtn.classList.remove('download-warning');
                void downloadBtn.offsetWidth;
                downloadBtn.classList.add('download-warning');
                alert('File needs to be converted first!');
                return;
            }

            document.getElementById('hiddenUrl').value = convertedFile.url;
            document.getElementById('hiddenTitle').value = document.getElementById('filenameInput').value.trim() || convertedFile.title;
            document.getElementById('hiddenFormat').value = convertedFile.format;
            saveDownloadToHistory(convertedFile);
            document.getElementById('hidden-dl-form').submit();
        });

        document.getElementById('clearUrlBtn').addEventListener('click', () => {
            const urlInput = document.getElementById('urlInput');
            urlInput.value = '';
            urlInput.focus();
        });

        document.getElementById('filenameToggle').addEventListener('click', () => {
            const filenamePanel = document.getElementById('filename-panel');
            const filenameToggle = document.getElementById('filenameToggle');
            const isHidden = filenamePanel.hidden;

            filenamePanel.hidden = !isHidden;
            filenameToggle.setAttribute('aria-expanded', String(isHidden));
            if (isHidden) document.getElementById('filenameInput').focus();
        });

        function getDefaultQualityForFormat(format) {
            const settings = ensureSavedSettings();
            return format === 'mp3' ? (settings.mp3 || '128') : (settings.mp4 || '720');
        }

        function renderQualityOptions(format, selectedValue) {
            const qualityInput = document.getElementById('qualityInput');
            if (!qualityInput) return;

            const isMp3 = format === 'mp3';
            const allowedValues = isMp3
                ? ['64', '128', '196', '256', '320']
                : ['360', '480', '720', '1080', '1440', '4k'];

            const labels = isMp3
                ? { '64': '64 kbps', '128': '128 kbps', '196': '196 kbps', '256': '256 kbps', '320': '320 kbps' }
                : { '360': '360p', '480': '480p', '720': '720p', '1080': '1080p', '1440': '1440p', '4k': '4K' };

            qualityInput.innerHTML = allowedValues.map((value) => `
                <option value="${value}" ${String(value) === String(selectedValue) ? 'selected' : ''}>${labels[value]}</option>
            `).join('');
        }

        document.getElementById('formatInput').addEventListener('change', (event) => {
            const qualityInput = document.getElementById('qualityInput');
            const isMp3 = event.target.value === 'mp3';
            convertedFile = null;

            const selectedValue = getDefaultQualityForFormat(event.target.value);
            renderQualityOptions(event.target.value, selectedValue);
        });

        document.getElementById('qualityInput').addEventListener('change', () => {
            convertedFile = null;
        });

        renderQualityOptions(document.getElementById('formatInput').value, getDefaultQualityForFormat(document.getElementById('formatInput').value));

            const mainForm = document.querySelector('.top-container form');

            mainForm.addEventListener('pointerenter', () => {
                mainForm.classList.add('pointer-active');
            });

            mainForm.addEventListener('pointermove', (event) => {
                const bounds = mainForm.getBoundingClientRect();
                const x = ((event.clientX - bounds.left) / bounds.width) * 100;
                const y = ((event.clientY - bounds.top) / bounds.height) * 100;

                mainForm.style.setProperty('--pointer-x', `${x}%`);
                mainForm.style.setProperty('--pointer-y', `${y}%`);
            });

            mainForm.addEventListener('pointerleave', () => {
                mainForm.classList.remove('pointer-active');
                mainForm.style.setProperty('--pointer-x', '50%');
                mainForm.style.setProperty('--pointer-y', '50%');
            });

    </script>
</body>
</html>