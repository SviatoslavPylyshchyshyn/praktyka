<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css?v=20260917-4">
    <link rel="icon" href="/favicon-konverter.png" type="image/png">
    <title>KONVERTER YT | Terms of usage</title>
</head>
<body>
    <div class="background-overlay" aria-hidden="true"></div>

    <div class="top-container">
        <div class="top-bar">
            <nav class="view-switcher" aria-label="Application views">
                <a class="view-tab" href="/" data-i18n="mainWindow">Home</a>
                <a class="view-tab" href="/history" data-i18n="downloadHistory">Download History</a>
                <a class="view-tab settings-tab" href="/settings" data-i18n="settings">Settings</a>
            </nav>
        </div>

        <main class="history-panel terms-panel">
            <h1 data-i18n="termsTitle">Terms of usage</h1>
            <div class="terms-content">
                <p data-i18n="termsText1">This app is provided for personal and educational use. The user is responsible for ensuring that downloading and converting content complies with local copyright laws and the terms of services of the platforms involved.</p>
                <p data-i18n="termsText2">By using this application, you agree that the service is offered as-is, without warranties and without guarantees of uninterrupted availability.</p>
                <p data-i18n="termsText3">The project may be used for personal conversions only and should not be used for unauthorized redistribution of protected content.</p>
            </div>
        </main>
    </div>

    <footer class="site-footer">
        <a href="/terms" class="footer-terms" data-i18n="termsUsage">Terms of usage</a>
        <a href="/contact" class="footer-terms" data-i18n="contact">Contact</a>
    </footer>

    <script>
        const translations = {
            en: {
                mainWindow: 'Home',
                downloadHistory: 'Download History',
                settings: 'Settings',
                contact: 'Contact',
                termsUsage: 'Terms of usage',
                languageLabel: 'Language',
                termsTitle: 'Terms of usage',
                termsText1: 'This app is provided for personal and educational use. The user is responsible for ensuring that downloading and converting content complies with local copyright laws and the terms of services of the platforms involved.',
                termsText2: 'By using this application, you agree that the service is offered as-is, without warranties and without guarantees of uninterrupted availability.',
                termsText3: 'The project may be used for personal conversions only and should not be used for unauthorized redistribution of protected content.'
            },
            uk: {
                mainWindow: 'Головна',
                downloadHistory: 'Історія завантажень',
                settings: 'Налаштування',
                contact: 'Контакт',
                termsUsage: 'Умови використання',
                languageLabel: 'Мова',
                termsTitle: 'Умови використання',
                termsText1: 'Цей додаток надається для особистого та освітнього використання. Користувач несе відповідальність за те, щоб завантаження та конвертація контенту відповідали місцевому законодавству про авторське право та умовам сервісів, що беруть участь.',
                termsText2: 'Користуючись цим застосунком, ви погоджуєтеся, що сервіс надається як є, без гарантій і без гарантій безперебійної доступності.',
                termsText3: 'Проєкт може використовуватися лише для особистих конверсій і не повинен використовуватися для несанкціонованого поширення захищеного контенту.'
            }
        };

        const settingsStorageKey = 'youtube-converter-settings';

        function ensureSavedSettings() {
            try {
                const saved = JSON.parse(localStorage.getItem(settingsStorageKey) || '{}');
                const safeSettings = saved && typeof saved === 'object' ? saved : {};
                localStorage.setItem(settingsStorageKey, JSON.stringify(safeSettings));
                return safeSettings;
            } catch {
                return {};
            }
        }

        ensureSavedSettings();

        function updateLanguageFlag() {
            const flag = document.getElementById('languageFlag');
            const select = document.getElementById('languageSelect');
            if (!flag || !select) return;
            flag.classList.toggle('english-flag', select.value === 'en');
            flag.classList.toggle('uk-flag', select.value === 'uk');
        }

        const languageStorageKey = 'youtube-converter-language';

        function getSavedLanguage() {
            try {
                const savedLanguage = localStorage.getItem(languageStorageKey);
                return savedLanguage === 'uk' || savedLanguage === 'en' ? savedLanguage : 'en';
            } catch {
                return 'en';
            }
        }

        function setLanguage(lang) {
            const dictionary = translations[lang] || translations.en;
            document.querySelectorAll('[data-i18n]').forEach((element) => {
                const key = element.getAttribute('data-i18n');
                if (dictionary[key]) {
                    element.textContent = dictionary[key];
                }
            });
        }

        const languageSelect = document.getElementById('languageSelect');
        const savedLanguage = getSavedLanguage();
        if (languageSelect) {
            languageSelect.value = savedLanguage;
            languageSelect.addEventListener('change', (event) => {
                const selectedLanguage = event.target.value;
                try {
                    localStorage.setItem(languageStorageKey, selectedLanguage);
                } catch {}
                updateLanguageFlag();
                setLanguage(selectedLanguage);
            });
        }
        updateLanguageFlag();
        setLanguage(savedLanguage);
    </script>
</body>
</html>
